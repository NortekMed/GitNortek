{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "README.md"
  ],
  "formatter": {
    "clang-format": {
      "command": [
        "clang-format",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".cpp",
        ".hpp",
        ".h",
        ".cc",
        ".cxx"
      ]
    }
  },
  "mcp": {
    "serena": {
      "enabled": true
    }
  },
  "permission": {
    "serena_find_*": "allow",
    "serena_get_*": "allow",
    "serena_initial_instructions": "allow",
    "serena_list_*": "allow",
    "serena_query_project": "allow",
    "serena_read_*": "allow",
    "serena_search_for_pattern": "allow",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "external_directory": {
      "~/.config/opencode/opencode.json": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/**": "allow",
          "~/.config/opencode/opencode.json": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "serena_find_*": "allow",
        "serena_get_*": "allow",
        "serena_initial_instructions": "allow",
        "serena_list_*": "allow",
        "serena_query_project": "allow",
        "serena_read_*": "allow",
        "serena_search_for_pattern": "allow",
        "edit": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "external_directory": {
          "/tmp/opencode/**": "allow"
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "build*/**",
      ".cache/**",
      "*.o",
      "*.a",
      "*.so",
      "*.dylib",
      "*.dll",
      "*.exe",
      "*.out",
      "compile_commands.json"
    ]
  }
}
