{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "README.md"
  ],
  "formatter": {
    "clang-format": {
      "command": [
        "clang-format",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".cpp",
        ".hpp",
        ".h",
        ".cc",
        ".cxx"
      ]
    }
  },
  "permission": {
    "serena_find_*": "allow",
    "serena_get_*": "allow",
    "serena_initial_instructions": "allow",
    "serena_list_*": "allow",
    "serena_query_project": "allow",
    "serena_read_*": "allow",
    "serena_search_for_pattern": "allow",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git merge*": "ask",
      "git merge-base*": "allow",
      "git submodule status*": "allow",
      "git config --get*": "allow",
      "git config -f .gitmodules --get*": "allow",
      "opencode mcp list*": "allow",
      "command -v *": "allow",
      "cmake --version*": "allow",
      "clang-format --version*": "allow",
      "clang-tidy --version*": "allow",
      "g++ --version*": "allow",
      "ninja --version*": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "mkdir -p build*": "allow",
      "cmake -B build*": "allow",
      "cmake -G *": "ask",
      "cmake * -B build*": "allow",
      "cmake --preset *": "allow",
      "cmake --build build*": "allow",
      "cmake --build --preset *": "allow",
      "ninja -C build*": "allow",
      "ctest*": "ask",
      "ctest --test-dir build*": "allow",
      "git submodule update*": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git stash*": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .git*": "deny",
      ".opencode/scripts/*": "ask"
    },
    "external_directory": {
      "~/.config/opencode/opencode.json": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "bash": {
          "*": "allow",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny",
          "rm -rf /": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~": "deny",
          "rm -rf ~/*": "deny",
          "rm -rf .git*": "deny",
          "git config --global *": "deny",
          "git config --system *": "deny"
        },
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/**": "allow",
          "~/.config/opencode/opencode.json": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "serena_find_*": "allow",
        "serena_get_*": "allow",
        "serena_initial_instructions": "allow",
        "serena_list_*": "allow",
        "serena_query_project": "allow",
        "serena_read_*": "allow",
        "serena_search_for_pattern": "allow",
        "edit": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
          "*": "allow",
          "git add*": "deny",
          "git apply*": "deny",
          "git bisect*": "deny",
          "git branch -D*": "deny",
          "git checkout*": "deny",
          "git clean*": "deny",
          "git commit*": "deny",
          "git config *": "deny",
          "git fetch*": "deny",
          "git merge*": "deny",
          "git pull*": "deny",
          "git push*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git restore*": "deny",
          "git revert*": "deny",
          "git stash*": "deny",
          "git submodule update*": "deny",
          "git switch*": "deny",
          "git tag*": "deny",
          "git worktree*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny",
          "chmod *": "deny",
          "chown *": "deny",
          "rm *": "deny",
          "rm -rf *": "deny",
          "rm -rf build*": "deny",
          "rm -rf /": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~": "deny",
          "rm -rf ~/*": "deny",
          "rm -rf .git*": "deny",
          "git config --get*": "allow",
          "git config -f .gitmodules --get*": "allow"
        },
        "external_directory": {
          "/tmp/opencode/**": "allow"
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "build*/**",
      ".cache/**",
      "*.o",
      "*.a",
      "*.so",
      "*.dylib",
      "*.dll",
      "*.exe",
      "*.out",
      "compile_commands.json"
    ]
  }
}
