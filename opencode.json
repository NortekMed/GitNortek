{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "README.md"
  ],
  "formatter": {
    "clang-format": {
      "command": [
        "clang-format",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".cpp",
        ".hpp",
        ".h",
        ".cc",
        ".cxx"
      ]
    }
  },
  "permission": {
    "*": "ask",
    "serena_find_*": "allow",
    "serena_get_*": "allow",
    "serena_initial_instructions": "allow",
    "serena_list_*": "allow",
    "serena_query_project": "allow",
    "serena_read_*": "allow",
    "serena_search_for_pattern": "allow",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git merge*": "ask",
      "git merge-base*": "allow",
      "git submodule status*": "allow",
      "git config --get*": "allow",
      "git config -f .gitmodules --get*": "allow",
      "opencode mcp list*": "allow",
      "command -v *": "allow",
      "cmake --version*": "allow",
      "clang-format --version*": "allow",
      "clang-tidy --version*": "allow",
      "g++ --version*": "allow",
      "ninja --version*": "allow",
      "ls": "allow",
      "pwd": "allow",
      "mkdir -p build*": "allow",
      "cmake -B build*": "allow",
      "cmake -G *": "ask",
      "cmake * -B build*": "allow",
      "cmake --preset *": "allow",
      "cmake --build build*": "allow",
      "cmake --build --preset *": "allow",
      "ninja -C build*": "allow",
      "ctest*": "ask",
      "ctest --test-dir build*": "allow",
      "git submodule update*": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git stash*": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .git*": "deny",
      ".opencode/scripts/*": "ask"
    },
    "external_directory": {
      "~/.config/opencode/opencode.json": "allow"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "*": "ask",
        "serena_find_*": "allow",
        "serena_get_*": "allow",
        "serena_initial_instructions": "allow",
        "serena_list_*": "allow",
        "serena_query_project": "allow",
        "serena_read_*": "allow",
        "serena_search_for_pattern": "allow",
        "edit": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git merge-base*": "allow",
          "git submodule status*": "allow",
          "git config --get*": "allow",
          "git config -f .gitmodules --get*": "allow",
          "opencode mcp list*": "allow",
          "command -v *": "allow",
          "cmake --version*": "allow",
          "clang-format --version*": "allow",
          "clang-tidy --version*": "allow",
          "g++ --version*": "allow",
          "ninja --version*": "allow",
          "ls": "allow",
          "pwd": "allow"
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "build*/**",
      ".cache/**",
      "*.o",
      "*.a",
      "*.so",
      "*.dylib",
      "*.dll",
      "*.exe",
      "*.out",
      "compile_commands.json"
    ]
  }
}
